# Copy to .env and edit. .env is never committed.

APP_NAME="Digital Library"
# php cli/console.php key:generate
APP_KEY=
APP_TAGLINE="A community library anyone can add to."
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FORCE_HTTPS=false

SESSION_NAME=dl_session
SESSION_LIFETIME=7200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital_library
DB_USERNAME=root
DB_PASSWORD=

# Where uploaded files live. Must be outside the webroot.
STORAGE_ROOT=

# 200 MB
MAX_UPLOAD_BYTES=209715200

# log = write mails to storage/logs instead of sending them
MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=library@localhost
MAIL_FROM_NAME="Digital Library"
