<?xml version="1.0"?>
<ruleset name="Digital Library">
    <description>PSR-12 with a few project rules.</description>

    <file>app</file>
    <file>cli</file>
    <file>config</file>
    <file>routes</file>
    <file>tests</file>
    <file>public/index.php</file>
    <file>bootstrap.php</file>

    <exclude-pattern>app/Views/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Entry points and config files exist to have side effects. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>bootstrap.php</exclude-pattern>
        <exclude-pattern>cli/console.php</exclude-pattern>
        <exclude-pattern>public/index.php</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/phpstan-bootstrap.php</exclude-pattern>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="140"/>
        </properties>
    </rule>
</ruleset>
